ne" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check w-3.5 h-3.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></p><p class="text-sm text-green-700 leading-snug">• h1</p><p class="text-sm text-green-700 leading-snug">• h2</p></div><div class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 space-y-1.5"><p class="text-xs font-bold text-amber-800">Try next time</p><p class="text-sm text-amber-700 leading-snug">• s1</p></div><div class="rounded-2xl border border-gray-100 bg-white shadow-sm overflow-hidden"><button type="button" class="w-full flex items-center justify-between px-4 py-3 text-sm font-semibold text-gray-600 hover:bg-gray-50 transition-colors"><span>Example answer</span><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></div></div><div class="flex gap-3 pt-1"><button type="button" class="flex-1 py-3 rounded-2xl text-white text-sm font-bold transition-transform duration-75 active:translate-y-1" style="background: rgb(54, 96, 171); box-shadow: 0 4px 0 #27497F;">common.tryAgain</button><button type="button" class="flex-1 py-3 rounded-2xl text-sm font-bold text-gray-600 border border-gray-200 bg-white hover:bg-gray-50 transition-colors">common.backToModes</button></div></div></div></div>"`;
